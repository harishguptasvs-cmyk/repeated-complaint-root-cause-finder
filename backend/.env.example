# Backend Environment Configuration Example
# Copy to .env or configure in cloud provider dashboard

# Database connection:
# - Leave blank or use sqlite:///./complaints.db for local development
# - For cloud deployment (e.g. Render/Supabase/Neon), provide the PostgreSQL connection string:
#   DATABASE_URL=postgresql://user:password@hostname:5432/dbname
DATABASE_URL=sqlite:///./complaints.db

# Production CORS Origins:
# Comma-separated list of allowed frontend origins (e.g., https://repeated-complaints.vercel.app)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
